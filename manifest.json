{
  "manifest_version": 3,
  "name": "Argon Bridge for AI Studio",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "Connect a project folder to Google AI Studio. Fill context, preview the latest model's files, and save reviewed changes.",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open Argon Bridge in Google AI Studio",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
